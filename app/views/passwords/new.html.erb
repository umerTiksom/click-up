<div class="container-fluid d-flex flex-column justify-content-center align-items-center min-vh-100">
  <h1 class="text-danger fw-bold fs-1">Click Up</h1>
<div class="card mt-3 w-75 border-0 shadow-sm">
  <div class="card-header text-center p-5 p-md-3 bg-danger ">
    <h1 class="text-danger fw-bold text-white">Forgot your password?</h1>
  </div>
  <div class="card-body text-center mt-3 ">
    <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

    <%= form_with url: passwords_path do |form| %>
      <%= form.email_field :email_address, class: "mb-0 p-2 w-75",required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address] %><br>
      <%= form.submit "Email reset",class: "mt-3 btn btn-danger p-2 fs-5 w-50 w-md-25"%>
    <% end %>
  </div>
</div>
</div>