<div class="container-fluid py-4 px-4">

  <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row task-start">

    <div class="">
      <h1 class="fw-bold text-danger mb-1">
        Tasks
      </h1>

      <p class="text-secondary mb-0">
        Tasks for <strong><%= @project.name %></strong>
      </p>
    </div>
    <% if policy(@project).edit? %>
    <%= link_to new_project_task_path(@project),
                class: "btn btn-danger px-4" do %>
      <i class="bi bi-plus-lg me-1"></i>
      New Task
    <% end %>
    <% end %>
  </div>

  <div class="card border-0  mb-4 w-50">
    <div class="card-body">

      <%= form_with url: project_tasks_path(@project),
                    method: :get,
                    local: true do |form| %>

        <div class="row g-3 align-items-end">

          <div class="col-md-4 ">

            <%= form.label :priority,
                           "Filter by Priority",
                           class: "form-label fw-semibold" %>

            <%= form.select :priority,
                            [
                              ["All Priorities", ""],
                              ["High", "high"],
                              ["Medium", "medium"],
                              ["Low", "low"]
                            ],
                            {
                              selected: params[:priority]
                            },
                            class: "form-select md-w-25" ,onchange: "this.form.submit()"%>

          </div>

          <div class="col-md-4">

            <%= form.label :status,
                           "Filter by Status",
                           class: "form-label fw-semibold" %>

            <%= form.select :status,
                            [
                              ["All Statuses", ""],
                              ["Pending", "pending"],
                              ["In Progress", "in-progress"],
                              ["Completed", "completed"]
                            ],
                            {
                              selected: params[:status]
                            },
                            class: "form-select",onchange: "this.form.submit()" %>

          </div>

        </div>

      <% end %>

    </div>


  </div>

  <% if @task.any? %>

    <div class="card border-0 shadow-sm">

      <div class="card-body p-0">

        <div class="table-responsive">

          <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

            <tr>

              <th class="px-4">ID</th>

              <th>Task Title</th>

              <th>Assigned To</th>

              <th>Priority</th>

              <th>Status</th>

              <th class="text-center">Actions</th>

            </tr>

            </thead>


            <tbody>

            <% @task.each_with_index do |task, index| %>

              <tr>

                <td class="px-4">
                  <%= index + 1 %>
                </td>


                <td>

                  <strong>
                    <%= task.tittle %>
                  </strong>

                </td>


                <td>

                  <% if task.assign_to.present? %>

                    <%= task.assign_to.name %>

                  <% else %>

                  <span class="text-secondary">
                    Not Assigned
                  </span>

                  <% end %>

                </td>


                <td>

                  <% if task.priority == "high" %>

                  <span class="badge bg-danger">
                    High
                  </span>

                  <% elsif task.priority == "medium" %>

                  <span class="badge bg-warning text-dark">
                    Medium
                  </span>

                  <% elsif task.priority == "low" %>

                  <span class="badge bg-success">
                    Low
                  </span>

                  <% end %>

                </td>


                <td>

                  <% if task.status == "completed" %>

                  <span class="badge bg-success">
                    Completed
                  </span>

                  <% elsif task.status == "in-progress" %>

                  <span class="badge bg-warning text-dark">
                    In Progress
                  </span>

                  <% elsif task.status == "pending" %>

                  <span class="badge bg-secondary">
                    Pending
                  </span>

                  <% end %>

                </td>


                <td>
                  <% if policy(task).update? %>
                  <div class="d-flex justify-content-center gap-2">

                    <%= link_to project_task_path(@project, task), class: "btn btn-sm btn-danger",title: "veiw task detail",data:{bs_toggle:"tooltip",bs_placement:"bottom"} do %>
                      <i class="bi bi-eye me-1"></i>

                    <% end %>

                    <%= link_to edit_project_task_path(@project, task),
                                class: "btn btn-sm btn-outline-secondary",data:{
                        bs_toggle:"tooltip",
                        bs_placement: "bottom"
                      },title:"Edit task" do %>

                      <i class="bi bi-pencil"></i>

                    <% end %>
                    <% if policy(task).destroy? %>


                    <%= button_to project_task_path(@project, task),
                                  method: :delete,
                                  title: "delete task",
                                  data: {
                                    turbo_confirm: "Are you sure you want to delete this task?",
                                    bs_toggle: "tooltip",
                                    bs_placement: "bottom"
                                  },
                                  class: "btn btn-sm btn-outline-danger" do %>

                      <i class="bi bi-trash"></i>

                    <% end %>
                    <% else %>
                      <%= button_to project_task_path(@project, task),
                                    method: :delete,
                                    title: "delete task",
                                    aria:{disabled: true},
                                    tabindex: (policy(task).destroy? ? nil : -1),
                                    data: {
                                      turbo_confirm: "Are you sure you want to delete this task?",
                                      bs_toggle: "tooltip",
                                      bs_placement: "bottom"
                                    },
                                    class: "btn btn-sm btn-outline-danger #{'disabled' unless policy(task).destroy?}" do %>

                        <i class="bi bi-trash"></i>

                      <% end %>
                    <% end %>
                  </div>
                    <% else %>
                    <div class="d-flex justify-content-center gap-2">

                      <%= link_to project_task_path(@project, task), class: "btn btn-sm btn-danger #{ 'disabled' unless policy(task).update?}",title: "veiw task detail",data:{bs_toggle:"tooltip",bs_placement:"bottom"},aria: {disabled: true},tabindex: (policy(task).update? ? nil : -1) do %>
                        <i class="bi bi-eye me-1"></i>

                      <% end %>

                      <%= link_to edit_project_task_path(@project, task),
                                  class: "btn btn-sm btn-outline-secondary #{'disabled' unless policy(task).update?}",data:{
                          bs_toggle:"tooltip",
                          aria:{disabled: true},tabindex: (policy(task).update? ? nil : -1),
                          bs_placement: "bottom"
                        },title:"Edit task" do %>

                        <i class="bi bi-pencil"></i>

                      <% end %>

                      <%= button_to project_tasks_path(@project, task),
                                    method: :delete,
                                    title: "delete task",
                                    aria:{disabled: true},tabindex: (policy(task).update? ? nil : -1),
                                    data: {
                                      turbo_confirm: "Are you sure you want to delete this task?",
                                      bs_toggle: "tooltip",
                                      bs_placement: "bottom"
                                    },
                                    class: "btn btn-sm btn-outline-danger #{'disabled' unless policy(task).update?}" do %>

                        <i class="bi bi-trash"></i>

                      <% end %>

                    </div>
                  <% end %>
                </td>

              </tr>

            <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  <% else %>


    <div class="card border-0 shadow-sm">

      <div class="card-body text-center py-5">

        <i class="bi bi-check2-square fs-1 text-secondary"></i>

        <h4 class="fw-bold mt-3">
          No Tasks Found
        </h4>

        <p class="text-secondary">
          No tasks match your selected filters.
        </p>

        <%= link_to new_project_task_path(@project),
                    class: "btn btn-danger" do %>

          <i class="bi bi-plus-lg me-1"></i>
          Create First Task

        <% end %>

      </div>

    </div>

  <% end %>

</div>
