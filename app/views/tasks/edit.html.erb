<div class="container-fluid p-4">

  <div class="d-flex flex-row justify-content-between align-items-center">
     <div class="">
         <h1 class="text-danger fw-bold">Update task</h1>
         <p class="text-secondary ">Update your task information</p>
     </div>
    <div class=" mb-2">
      <%=link_to project_task_path(@project),class:"btn btn-primary btn-text-white me-1 border-0" do %>
        <i class="bi bi-x-lg"></i>
      Cancel
      <% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <%= form_with model: [@project, @task] do |form| %>
      <% if @task.errors.any? %>
        <div class="alert alert-danger">
          <h5>Please fix these errors before update</h5>
          <ul>
            <% @task.errors.full_messages.each do |msg| %>
            <li>
              <%= msg %>
            </li>
            <% end %>
          </ul>
        </div>
        <% end %>
        <% if policy(@task).destroy? %>
        <div>
          <%=form.label :tittle, "Task Tittle",class: "form-label fw-semibold text-black"%>
          <%= form.text_field :tittle,class: 'form-control'%>
        </div>
        <div class="mt-2">
          <%= form.label :description, "Task Description",class: "form-label fw-semibold mt-4"%>
          <%= form.text_area :description , class: "form-control"%>
        </div>
        <div class="mt-4 ">
          <%= form.label :priority, "Priority", class:"form-label fw-semibold d-block"%>
          <div class="d-flex gap-3 mt-2">
            <div class="form-check">
               <%= form.radio_button :priority, "high", class: "form-check-input"%>
               <%= form.label :priority_high, "High", class: "form-check-label"%>
            </div>
            <div class="form-check">
              <%= form.radio_button :priority, "medium", class: "form-check-input"%>
              <%= form.label  "Medium", class: "form-check-label"%>
            </div>
            <div class="form-check">
              <%= form.radio_button :priority, "low", class: "form-check-input"%>
              <%= form.label "Low",class:"form-check-label"%>
            </div>
          </div>
        </div>
        <div class="mt-4">
          <%= form.label :status, "Status", class: "form-label fw-semibold"%>
          <%= form.select :status, [["Pending","pending"],["In Progress", "in-progress"],["Completed","completed"]],
                          {
                            prompt:"Select status"
                          }, class: "form-select"
          %>
        </div>

        <div class="mt-4">
          <%= form.label :assign_to_id, "Assign Task", class:"form-label fw-semibold d-block"%>
          <%= form.select :assign_to_id, [["Assign to me (#{Current.user.name})",Current.user.id]]+
          @users.reject { |user| user.id == Current.user.id }
            .map { |user| [user.name,user.id]  },{
            prompt:"Select Task owner",

          },class:"mt-2 d-block p-2 w-100 form-select"%>
        </div>
        <% else %>
          <div >
            <%=form.label :tittle, "Task Tittle",class: "form-label fw-semibold text-black"%>
            <%= form.text_field :tittle, disabled:true ,class: 'form-control'%>
          </div>
          <div class="mt-2">
            <%= form.label :description, "Task Description",class: "form-label fw-semibold mt-4"%>
            <%= form.text_area :description,disabled:true , class: "form-control"%>
          </div>
          <div class="mt-4 ">
            <%= form.label :priority, "Priority", class:"form-label fw-semibold d-block"%>
            <div class="d-flex gap-3 mt-2">
              <div class="form-check">
                <%= form.radio_button :priority, "high", disabled:true,class: "form-check-input"%>
                <%= form.label :priority_high, "High", class: "form-check-label"%>
              </div>
              <div class="form-check">
                <%= form.radio_button :priority, "medium", disabled:true,class: "form-check-input"%>
                <%= form.label  "Medium", class: "form-check-label"%>
              </div>
              <div class="form-check">
                <%= form.radio_button :priority, "low", disabled:true,class: "form-check-input"%>
                <%= form.label "Low",class:"form-check-label"%>
              </div>
            </div>
          </div>
          <div class="mt-4">
            <%= form.label :status, "Status", class: "form-label fw-semibold"%>
            <%= form.select :status, [["Pending","pending"],["In Progress", "in-progress"],["Completed","completed"]],
                            {
                              prompt:"Select status"
                            }, class: "form-select"
            %>
          </div>

          <div class="mt-4">
            <%= form.label :assign_to_id, "Assign Task", class:"form-label fw-semibold d-block"%>
            <%= form.select :assign_to_id, [["Assign to me (#{Current.user.name})",Current.user.id]]+
              @users.reject { |user| user.id == Current.user.id }
                    .map { |user| [user.name,user.id]  },{
                              prompt:"Select Task owner",

                            },disabled:true,class:"mt-2 d-block p-2 w-100 form-select"%>
          </div>
        <% end %>
        <%= form.submit "Update task", class: "btn btn-danger px-4 fw-semibold mt-5"%>

         </div>
      <% end %>
  </div>
</div>