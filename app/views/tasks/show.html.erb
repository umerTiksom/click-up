<div class="container-fluid py-4 px-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h1 class="fw-bold text-danger mb-1">
        Task Details
      </h1>

      <p class="text-secondary mb-0">
        View specific task information
      </p>
    </div>

    <div class="d-flex gap-2">

      <%= link_to project_tasks_path(@project),
                  class: "btn bg-primary text-white" do %>
        <i class="bi bi-arrow-left me-1 "></i>
        Back
      <% end %>

      <%= link_to edit_project_task_path(@project, @task),
                  class: "btn btn-danger" do %>
        <i class="bi bi-pencil me-1"></i>
        Edit
      <% end %>

    </div>

  </div>

  <div class="card border-1 shadow">
    <div class="card-body p-4 border-top-1">
      <div class="d-flex justify-content-between align-items-center">
         <div class="mb-4 w-50">
            <small class="text-secondary">
               Task Title
            </small>

            <h2 class="fw-bold mt-1">
               <%= @task.tittle %>
            </h2>
         </div>
         <div class="mb-4 w-50">
             <small class="text-secondary">
                 Task Decription
             </small>

             <h4 class="fw-semibold mt-1">
                 <%= @task.description %>
             </h4>
          </div>
       </div>
      <div class=" pt-4">

        <div class="row">

          <div class="col-md-6 mb-3">

            <small class="text-secondary d-block mb-1">
              Assigned To
            </small>

            <% if @task.assign_to.present? %>

              <div class="d-flex align-items-center gap-2">

                <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 40px; height: 40px;">

              <span class="text-white fw-bold">
                <%= @task.assign_to.name.first.upcase %>
              </span>

                </div>

                <strong>
                  <%= @task.assign_to.name %>
                </strong>

              </div>

            <% else %>

          <span class="text-secondary">
            Not Assigned
          </span>

            <% end %>

          </div>


          <div class="col-md-6 mb-3">

            <small class="text-secondary d-block mb-1">
              Project
            </small>

            <strong>
              <%= @project.name %>
            </strong>

          </div>
          <div class="row  ">
          <div class="col-md-6 d-flex flex-column mt-3 ">
            <small class="text-secondary d-block">Status</small>
            <strong class="badge text-primary bg-primary-subtle  rounded-pill bg-opacity-75 p-2 mt-3 w-25 text-capitalize shadow"><%= @task.status %></strong>
          </div>

          <div class="col-md-6 d-flex flex-column mt-3">
            <small class="text-secondary d-block">Priority</small>
            <strong class="badge text-success bg-success bg-success-subtle bg-opacity-25 text-capitalize  rounded-pill bg-opacity-75 p-2 mt-3 w-25 shadow"><%= @task.priority%></strong>
          </div>
        </div>
        </div>

      </div>

    </div>
  </div>

</div>
