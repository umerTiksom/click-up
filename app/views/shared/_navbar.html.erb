
<nav class="p-3 d-none d-md-flex flex-column border-3 shadow bg-white"
     style="width: 260px; min-height: 100vh;">

  <div class="text-center mb-4">

    <%= link_to home_path,
                class: "text-danger text-decoration-none fw-bold fs-3" do %>
      Click Up
    <% end %>

  </div>

  <div class="text-center border-bottom border-secondary pb-4 mb-4">

    <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center mx-auto mb-2"
         style="width: 55px; height: 55px;">

      <span class="fw-bold fs-4 text-white">
        <%= Current.user.name.first.upcase %>
      </span>

    </div>

    <h6 class="mb-0 text-danger">
      <%= Current.user.name %>
    </h6>

    <small class="text-secondary">
      <%= Current.user.email_address %>
    </small>

  </div>

  <ul class="nav flex-column gap-2">

    <li class="nav-item">
      <%= link_to home_path, class: "nav-link text-danger" do %>
        <i class="bi bi-speedometer2 me-2"></i>
        Dashboard
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to projects_path, class: "nav-link text-danger" do %>
        <i class="bi bi-folder me-2"></i>
        Projects
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to new_project_path, class: "nav-link text-danger" do %>
        <i class="bi bi-folder-plus me-2"></i>
        New Project
      <% end %>
    </li>

  </ul>

  <div class="mt-auto">

    <%= button_to logout_path,
                  method: :delete,
                  class: "btn btn-danger w-100" do %>

      <i class="bi bi-box-arrow-right me-2"></i>
      Logout

    <% end %>

  </div>

</nav>

<div class="offcanvas offcanvas-start d-md-none"

     id="mobileNavbar">

  <div class="offcanvas-header justify-content-center">

    <%= link_to home_path,
                class: "text-decoration-none" do %>

      <div class="rounded-circle bg-danger
                  d-flex align-items-center justify-content-center"
           style="width: 55px; height: 55px;">

        <span class="fw-bold fs-4 text-white">
          <%= Current.user.name.first.upcase %>
        </span>

      </div>

    <% end %>


  </div>

  <div class="offcanvas-body">

    <ul class="nav flex-column gap-3">
      <li class="nav-item">

        <%= link_to home_path,
                    class: "nav-link text-danger text-center fs-4" do %>

          <i class="bi bi-speedometer2"></i>

        <% end %>

      </li>

      <li class="nav-item">

        <%= link_to projects_path,
                    class: "nav-link text-danger text-center fs-4" do %>

          <i class="bi bi-folder"></i>

        <% end %>

      </li>

      <li class="nav-item">

        <%= link_to new_project_path,
                    class: "nav-link text-danger text-center fs-4" do %>

          <i class="bi bi-folder-plus"></i>

        <% end %>

      </li>

    </ul>

    <div class="mt-md-auto mt-4 text-center">

      <%= button_to logout_path,
                    method: :delete,
                    class: "btn btn-danger",
                    title: "Logout" do %>

        <i class="bi bi-box-arrow-right fs-4"></i>

      <% end %>

    </div>

  </div>

</div>