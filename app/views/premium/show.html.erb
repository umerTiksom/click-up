<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center" style="background: linear-gradient(135deg,#b2fff2,#6f42c1)">
  <div class="row justify-content-center ">
    <div class="col-md-10  w-100">

      <div class="card border-0 shadow-sm">
        <div class="card-body text-center p-5">

          <h2 class="fw-bold mb-3">
            Upgrade to Premium
          </h2>

          <p class="text-muted mb-4">
            You have reached the maximum limit of
            <strong>12 projects</strong> on the Free plan.
          </p>

          <div class="alert alert-success">
            Free Plan:
            <strong>12 projects maximum</strong>
          </div>

          <p class="text-muted">
            Upgrade to Premium to create more projects.
          </p>

          <%= button_to "Upgrade to Premium",
                        subscriptions_path,
                        method: :post,
                        data: { turbo: false },
                        class: "btn btn-danger mt-3" %>

        </div>
      </div>

    </div>
  </div>
</div>