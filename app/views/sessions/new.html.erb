
<div class="container-fluid min-vh-100  d-flex align-items-center justify-content-center py-4">

  <div class="container">
    <div class="row justify-content-center">


      <div class="col-12 col-sm-9 col-md-8 col-lg-7 col-xl-6">

        <div class="card shadow-lg border-2 rounded-4">

          <div class="card-body p-4 p-md-5">

            <div class="text-center mb-4">
              <h1 class="text-danger fw-bold mb-2">
                Sign In
              </h1>

              <p class="text-muted mb-0">
                Welcome back to Click Up
              </p>
            </div>


            <% if flash[:alert] %>
              <div class="alert alert-danger text-center">
                <%= flash[:alert] %>
              </div>
            <% end %>

            <%= form_with url: login_path, method: :post do |form| %>

              <div class="mb-3">

                <%= form.label :email_address,
                               "Email Address",
                               class: "form-label fw-semibold" %>

                <%= form.email_field :email_address,
                                     class: "form-control form-control-lg",
                                     placeholder: "Enter your email...",
                                     autocomplete: "email",
                                     required: true %>

              </div>

              <div class="mb-4">

                <%= form.label :password,
                               "Password",
                               class: "form-label fw-semibold" %>

                <%= form.password_field :password,
                                        class: "form-control form-control-lg",
                                        placeholder: "Enter your password...",
                                        autocomplete: "current-password",
                                        required: true %>

              </div>

              <div class="d-grid">

                <%= form.submit "Sign In",
                                class: "btn btn-danger btn-lg rounded-3" %>

              </div>

            <% end %>

            <div class="text-center mt-4">

              <p class="text-muted mb-0">
                Don't have an account?

                <%= link_to "Sign Up",
                            signup_path,
                            class: "text-danger fw-semibold text-decoration-none  " %>
              </p>

                <p class="text-muted mb-0 mt-3">
                  Forget Password?

                  <%= link_to "Forget Password",
                              new_password_path,
                              class: "text-primary fw-semibold text-decoration-none  " %>
                </p>

            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

</div>

