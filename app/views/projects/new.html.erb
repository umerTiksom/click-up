<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center">

  <div class="card p-4 w-75  rounded-4 border-1 shadow-lg">
    <h1 class="text-center text-danger fw-bolder fs-1">Create a new project</h1>
    <%= form_with model: @project do |form|%>
    <% if @project.errors.any? %>
      <div>
        <h2>Unable to create the project</h2>
        <ul>
          <% @project.errors.full_messages.each do |msg|  %>
              <li><%=msg %></li>
          <% end %>
        </ul>
      </div>
      <% end %>
      <div>

      </div>
      <div class="form p-3">
        <div class="d-flex flex-column mt-4 fs-4 ">
           <%= form.label :name , "Project Name:",class: "text-danger form-label fw-semibold" %>
           <%= form.text_field :name ,class: "mt-3 rounded form-control-lg form-control p-2", placeholder: "Enter the project name..." %>
        </div>
        <div class=" mt-4 d-flex flex-column fs-4">
          <%= form.label :description , "Project Description:", class:"text-danger form-label fw-semibold" %>
          <%= form.text_field :description ,class: "mt-3 form-control form-control-lg p-2",placeholder: "Enter the project description..."%>
        </div>
        <div class="mt-5 text-center" >
          <%= form.submit "Create Project" ,class: " p-3 fs-5 fw-semibold bg-danger text-white border-0 rounded-1 w-100" %>
        </div>
      </div>
    <% end %>

  </div>

</div>