
<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center px-2 px-sm-3 py-4">

  <div class="card w-100 p-3 p-sm-4 rounded-4 border-1 shadow-lg"
       style="max-width: 900px;">

    <h1 class="text-center text-danger fw-bolder fs-2 fs-md-1 mb-4">
      Create a new project
    </h1>

    <%= form_with model: @project do |form| %>

      <% if @project.errors.any? %>

        <div class="alert alert-danger">

          <h5 class="mb-2">
            Unable to create the project
          </h5>

          <ul class="mb-0">
            <% @project.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>

        </div>

      <% end %>

      <div class="px-1 px-sm-2 px-md-3">

        <div class="mb-4">

          <%= form.label :name,
                         "Project Name:",
                         class: "text-danger form-label fw-semibold fs-6 fs-md-5" %>

          <%= form.text_field :name,
                              class: "form-control form-control-lg mt-2",
                              placeholder: "Enter the project name..." %>

        </div>

        <div class="mb-4">

          <%= form.label :description,
                         "Project Description:",
                         class: "text-danger form-label fw-semibold fs-6 fs-md-5" %>

          <%= form.text_area :description,
                             rows: 5,
                             class: "form-control form-control-lg mt-2",
                             placeholder: "Enter the project description..." %>

        </div>

        <div class="mt-4">

          <%= form.submit "Create Project",
                          class: "btn btn-danger w-100 p-2 p-md-3 fs-6 fs-md-5 fw-semibold" %>

        </div>

      </div>

    <% end %>

  </div>

</div>
