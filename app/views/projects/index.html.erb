
<div class="container-fluid py-4 px-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-danger mb-1">Projects</h1>
      <p class="text-secondary mb-0">
        Manage all your projects from here.
      </p>
    </div>

    <%= link_to new_project_path,
                class: "btn btn-danger px-4 py-2 fw-semibold" do %>
      <i class="bi bi-plus-lg me-2"></i>
      New Project
    <% end %>
  </div>

  <%= form_with url: projects_path,
                method: :get,
                local: true do |form| %>

    <div class="input-group">
      <span class="input-group-text bg-white">
        <i class="bi bi-search"></i>
      </span>

      <%= form.text_field :search,
                          value: params[:search],
                          class: "form-control",
                          placeholder: "Search Project Here....",
                          autocomplete: "off" %>
    </div>

  <% end %>

  <% if @project.any? %>

    <div class="row g-4 mt-4">

      <% @project.each do |project| %>

        <div class="col-md-6 col-30">

          <div class="card border-1 shadow h-100 ">

            <div class="card-body p-4">

              <div class="d-flex align-items-center mb-3">

                <div class="bg-danger bg-opacity-10 rounded-3 p-4 me-3">
                  <i class="bi bi-folder-fill text-danger fs-4"></i>
                </div>

                <div>

                  <div class="d-flex align-items-center gap-2">

                    <h5 class="fw-bold mb-0">
                      <%= project.name %>
                    </h5>
                  </div>
                  <div class="d-flex flex-column">
                  <small class="text-secondary">
                    Project #<%= project.id %>
                  </small>
                  <small class="text-secondary"> created by <%= project.user.name %> </small>
                  </div>
                </div>

              </div>

              <p class="text-secondary mb-4">
                <%= truncate(project.description, length: 120) %>
              </p>

              <div class="d-flex justify-content-between align-items-center
                          bg-light rounded-3 p-3 mb-4">

                <span class="text-secondary">
                  <i class="bi bi-list-task me-2"></i>
                  Tasks
                </span>

                <span class="fw-bold text-danger">
                  <%= project.tasks.count %>
                </span>

              </div>

              <div class="d-flex gap-2">

                <% if policy(project).show? %>

                  <%= link_to project_path(project),
                              class: "btn btn-danger flex-grow-1",
                              data: {
                                bs_toggle: "tooltip",
                                bs_placement: "bottom"
                              },
                              title: "View project details" do %>

                    <i class="bi bi-eye me-1"></i>
                    View

                  <% end %>
                <% end %>

                <% if policy(project).update? %>

                  <%= link_to edit_project_path(project),
                              class: "btn btn-outline-secondary",
                              data: {
                                bs_toggle: "tooltip",
                                bs_placement: "bottom"
                              },
                              title: "Edit project" do %>

                    <i class="bi bi-pencil"></i>

                  <% end %>

                  <%= button_to project_path(project),
                                method: :delete,
                                title: "Delete Project",
                                data: {
                                  bs_toggle: "tooltip",
                                  bs_placement: "bottom",
                                  turbo_confirm: "Are you sure you want to delete this project?"
                                },
                                class: "btn btn-danger" do %>

                    <i class="bi bi-trash"></i>

                  <% end %>
                  <%else %>

                  <%= link_to edit_project_path(project),
                              class: "btn btn-outline-secondary #{'disabled' unless policy(project).update?}",
                              aria: {
                                disabled: true
                              },
                              tabindex: (policy(project).update? ? nil : -1),
                              data: {
                                bs_toggle: "tooltip",
                                bs_placement: "bottom"
                              },
                              title: "Edit project" do %>

                    <i class="bi bi-pencil"></i>

                  <% end %>

                  <%= button_to project_path(project),
                                class: "btn btn-outline-secondary #{'disabled' unless policy(project).update?}",
                                method: :delete,
                                tabindex: (policy(project).update? ? nil : -1),
                                title: "Delete Project",
                                aria:{disabled:true},
                                data: {
                                  bs_toggle: "tooltip",
                                  bs_placement: "bottom",
                                  turbo_confirm: "Are you sure you want to delete this project?"
                                } do %>

                    <i class="bi bi-trash"></i>

                  <% end %>
                <% end %>

              </div>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="text-center py-5">

      <div class="mb-3">

        <i class="bi bi-folder-x text-secondary"
           style="font-size: 70px;"></i>

      </div>

      <h4 class="fw-bold">
        No Projects Yet
      </h4>

      <p class="text-secondary mb-4">
        You haven't created any projects yet.
      </p>

      <%= link_to new_project_path,
                  class: "btn btn-danger px-4 py-2 fw-semibold" do %>

        <i class="bi bi-plus-lg me-2"></i>
        Create Your First Project

      <% end %>

    </div>

  <% end %>

</div>
